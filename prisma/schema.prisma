generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SELLER
  CLUSTER_ADMIN
  PLATFORM_ADMIN
  CUSTOMER
  AGENT_COURIER
  ADMIN_ORGANIZATION
}

enum OrganizationType {
  MARKETPLACE
  CAMPUS
  COMMUNITY
}

enum StoreType {
  KANTIN
  SELLER_UMKM
  RESTORAN
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  ON_DELIVERY
  COMPLETED
  CANCELLED
}

enum CourierTaskType {
  PICKUP
  DELIVERY
}

enum CourierTaskStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum ClusterMemberStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum CourierType {
  JNE
  JNT
  SICEPAT
  ANTERAJA
  OTHER
}

enum PickupWindow {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

enum ShipmentDraftStatus {
  DRAFT
  QUEUED
  READY_FOR_PICKUP
  PICKED_UP
  SHIPPED
  DELIVERED
  CANCELLED
}

enum GroupPickupStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  WAIVED
}

model Organization {
  id          String           @id @default(cuid())
  name        String
  type        OrganizationType @default(CAMPUS)
  domain      String?          @unique
  settings    String?          // JSON metadata: deliveryWindows, platformCut, defaultFee
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       User[]
  stores      Store[]
  orders      Order[]
  batches     DeliveryBatch[]

  @@index([type])
}

model Store {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  type           StoreType @default(KANTIN)
  location       String    // e.g. "Kantin Pusat Lt. 1", "Ruko Blok B"
  contactPhone   String?
  isOpen         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]
  orders         Order[]

  @@index([organizationId, type])
}

model Product {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  price       Int
  weight      Int      @default(300) // gram
  category    String?  @default("Makanan")
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@index([storeId, isAvailable])
}

model Order {
  id             String      @id @default(cuid())
  organizationId String
  customerId     String
  storeId        String
  batchId        String?
  status         OrderStatus @default(PENDING)
  totalPrice     Int
  deliveryFee    Int         @default(3000)
  deliveryWindow String      @default("12:00") // e.g. "12:00", "17:00"
  dropoffLocation String     // e.g. "Gedung Riset Lt. 3", "Asrama Putri Kamar 204"
  customerNotes  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       User           @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  batch          DeliveryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  items          OrderItem[]

  @@index([organizationId, status])
  @@index([customerId])
  @@index([batchId])
  @@index([storeId, status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  qty       Int     @default(1)
  price     Int     // Harga satuan saat dipesan
  notes     String?

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model DeliveryBatch {
  id             String      @id @default(cuid())
  organizationId String
  code           String      @unique // e.g. "BATCH-20261031-1200-CAMPUS"
  deliveryWindow String      // "12:00", "17:00"
  status         OrderStatus @default(PENDING) // PENDING, ON_DELIVERY, COMPLETED
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders         Order[]
  courierTasks   CourierTask[]

  @@index([organizationId, deliveryWindow, status])
}

model CourierTask {
  id         String            @id @default(cuid())
  agentId    String
  batchId    String
  type       CourierTaskType   @default(DELIVERY) // PICKUP or DELIVERY
  status     CourierTaskStatus @default(ASSIGNED)
  targetName String            // "Kantin Bu Slamet" or "Gedung Rektorat Lt. 2"
  address    String            // Location details
  orderCount Int               @default(1)
  feeEarned  Int               @default(3000)
  sequence   Int               @default(1) // Urutan rute (1, 2, 3...)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  agent      User          @relation("AgentTasks", fields: [agentId], references: [id], onDelete: Cascade)
  batch      DeliveryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([agentId, status])
  @@index([batchId])
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  passwordHash   String?
  phone          String?
  role           UserRole      @default(SELLER)
  organizationId String?
  storeName      String?
  businessType   String?
  address        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  managedClusters Cluster[]       @relation("ClusterAdmin")
  memberships     ClusterMember[]
  shipmentDrafts  ShipmentDraft[]
  pickupItems     PickupItem[]
  paymentRecords  PaymentRecord[]
  notifications   Notification[]
  activityLogs    ActivityLog[]

  customerOrders  Order[]       @relation("CustomerOrders")
  courierTasks    CourierTask[] @relation("AgentTasks")

  @@index([email])
  @@index([role])
  @@index([organizationId])
}

model Cluster {
  id                 String   @id @default(cuid())
  name               String
  code               String   @unique
  description        String
  centerAddress      String
  radiusKm           Float    @default(3.0)
  pickupDays         String[]
  pickupTimeWindows  String[]
  minPackages        Int      @default(10)
  minTotalWeightGram Int      @default(10000)
  basePickupFee      Int      @default(25000)
  platformFeePercent Float    @default(10.0)
  adminId            String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  admin          User            @relation("ClusterAdmin", fields: [adminId], references: [id])
  members        ClusterMember[]
  shipmentDrafts ShipmentDraft[]
  groupPickups   GroupPickup[]

  @@index([code])
  @@index([adminId])
}

model ClusterMember {
  id        String              @id @default(cuid())
  clusterId String
  userId    String
  status    ClusterMemberStatus @default(PENDING)
  joinedAt  DateTime            @default(now())

  cluster Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clusterId, userId])
  @@index([userId, status])
  @@index([clusterId, status])
}

model ShipmentDraft {
  id                 String              @id @default(cuid())
  userId             String
  clusterId          String
  recipientName      String
  recipientPhone     String
  destinationAddress String
  city               String
  province           String
  postalCode         String
  weightGram         Int
  lengthCm           Float
  widthCm            Float
  heightCm           Float
  itemValue          Int
  notes              String?
  courier            CourierType
  pickupDate         DateTime
  pickupWindow       PickupWindow
  status             ShipmentDraftStatus @default(QUEUED)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cluster    Cluster     @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  pickupItem PickupItem?

  @@index([clusterId, pickupDate, pickupWindow, courier, status])
  @@index([userId, status])
}

model GroupPickup {
  id                 String            @id @default(cuid())
  code               String            @unique
  clusterId          String
  courier            CourierType
  pickupDate         DateTime
  pickupWindow       PickupWindow
  pickupTime         String?           @default("16:00")
  totalPackages      Int
  totalWeightGram    Int
  basePickupFee      Int
  platformFeePercent Float
  totalCost          Int
  roundingDiff       Int               @default(0)
  forcedBelowMin     Boolean           @default(false)
  costLocked         Boolean           @default(false)
  status             GroupPickupStatus @default(SCHEDULED)
  createdAt          DateTime          @default(now())
  completedAt        DateTime?

  cluster        Cluster         @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  items          PickupItem[]
  paymentRecords PaymentRecord[]

  @@index([clusterId, status])
  @@index([code])
}

model PickupItem {
  id              String @id @default(cuid())
  groupPickupId   String
  shipmentDraftId String @unique
  sellerId        String
  weightGram      Int
  costShare       Int
  platformFee     Int
  totalCharge     Int

  groupPickup   GroupPickup   @relation(fields: [groupPickupId], references: [id], onDelete: Cascade)
  shipmentDraft ShipmentDraft @relation(fields: [shipmentDraftId], references: [id], onDelete: Cascade)
  seller        User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([groupPickupId])
  @@index([sellerId])
}

model PaymentRecord {
  id              String        @id @default(cuid())
  groupPickupId   String
  sellerId        String
  totalWeightGram Int           @default(0)
  weightPercent   Float         @default(0)
  costShare       Int           @default(0)
  platformFee     Int           @default(0)
  roundingAdjust  Int           @default(0)
  amount          Int
  status          PaymentStatus @default(UNPAID)
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  groupPickup GroupPickup @relation(fields: [groupPickupId], references: [id], onDelete: Cascade)
  seller      User        @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([groupPickupId, sellerId])
  @@index([sellerId, status])
}

model PlatformConfig {
  id                    String   @id @default("default")
  defaultBasePickupFee  Int      @default(25000)
  defaultPlatformFeePct Float    @default(10.0)
  defaultMinPackages    Int      @default(10)
  defaultMinWeightGram  Int      @default(10000)
  soloPickupEstimateRp  Int      @default(15000)
  updatedAt             DateTime @updatedAt
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  title          String
  message        String
  type           String   @default("INFO")
  link           String?
  isRead         Boolean  @default(false)
  whatsappStatus String   @default("PENDING_INTEGRATION")
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String
  actorName  String
  actorRole  String
  action     String
  entityType String
  entityId   String
  summary    String
  details    String?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([createdAt])
}
